{
  "name": "splitline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Analytics layer over the MCSR Ranked API",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "web": "npm run dev --prefix web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run build --prefix web",
    "fixtures": "node scripts/fetch-fixtures.mjs",
    "calibrate": "tsx scripts/calibrate.ts"
  },
  "dependencies": {
    "@fastify/compress": "^9.1.0",
    "@fastify/static": "^8.2.0",
    "fastify": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
