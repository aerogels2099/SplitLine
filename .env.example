# All MCSR Ranked endpoints are public except GET /users/{id}/live.
# Generate in-game: Profile -> Settings -> Generate & Copy API Private Key.
# Optional — only needed for the private-room live view.
MCSR_PRIVATE_KEY=

# Server port (frontend dev server proxies /api here)
PORT=8787

# SQLite database location
SPLITLINE_DB=data/splitline.db
